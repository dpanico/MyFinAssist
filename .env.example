# Required for Supabase Auth and database access.
# Local Supabase default: http://127.0.0.1:54321
# Live Supabase format: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Required browser-safe Supabase publishable/anon key.
# Local Supabase prints this after `supabase start`.
# Do not put a service_role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Future provider placeholders. Phase 1 does not use these values and the app
# must run without them.
PLAID_CLIENT_ID=
PLAID_SECRET=
SIMPLEFIN_BRIDGE_URL=
TELLER_APPLICATION_ID=
SNAPTRADE_CLIENT_ID=
OPENAI_API_KEY=
